# Copy this file to .env (in your project root) and fill in real values.
# .env should NOT be committed to version control.

# Your GitLab instance's base URL — no trailing slash, no /api/v4 suffix.
GITLAB_URL=https://gitlab.example.com

# A personal or project access token with `api` scope (needed to post
# comments/threads; `read_api` scope is enough for read-only use).
# Create one under GitLab -> Preferences -> Access Tokens.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Optional: default project so you don't need --project on every call.
# Either the numeric project ID or the "group/subgroup/repo" path.
GITLAB_PROJECT_ID=group/subgroup/repo
