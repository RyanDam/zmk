 *
 * Coban Tab 1a DEV HARNESS overlay: bench bring-up of the final board's
 * peripherals (4-key matrix, WS2812 bar, I2S tone, VBAT ADC). Not a product
 * build. Probes: app/src/tab1a/; pins + bench wiring: ../tab1a-hardware-map.md.
 *   sh zmk/esp-port/build_cobantab1a.sh -O zmk/esp-port/bringup/tab1a-devkit.overlay -C zmk/esp-port/bringup/tab1a-devkit.conf
 * Applied AFTER the cobantab1a shield's own overlay.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>
#include <dt-bindings/led/led.h>

/* TRC, not RC: the shield keymap's right-ctrl RC macro is in this
 * preprocessing chain. Expansion matches zmk's matrix_transform.h RC(). */
#define TRC(row, col) (((row) << 8) + (col))

&kscan0 {
    /* Harness 2x2 matrix on P2: diodes row -> col, key to GND. Never IO5
     * (VBAT) or IO9 (BOOT); IO16 doubles as SPI3 SCLK for the light bar. */
    row-gpios
        = <&gpio0 7  GPIO_ACTIVE_HIGH>
        , <&gpio0 14 GPIO_ACTIVE_HIGH>
        ;

    col-gpios
        = <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
};

/* No transform overrides: the shield dtsi already carries the 4x4 shape the
 * keymap's bindings require. */

/ {
    /* VBAT sense: ADC1 ch 4 = GPIO5; divider ratio recorded in the hardware map. */
    tab1a_vbat: tab1a-vbat {
        compatible = "zephyr,user";
        io-channels = <&adc1 4>;
    };

    /* DS1302: no node on purpose — the in-tree maxim,ds1302 driver needs
     * bit-bang SPI this tree lacks. Proposed IOs: SCLK=17, IO=18, CE=6. */
};

&pinctrl {
    i2s0_default: i2s0_default {
        group1 {
            pinmux = <I2S0_O_WS_GPIO2>,   /* LRCLK */
                     <I2S0_O_BCK_GPIO42>, /* BCLK  */
                     <I2S0_O_SD_GPIO41>;  /* DATA -> amp DIN */
        };
    };

    spim3_default: spim3_default {
        group1 {
            /* DEVKIT ONLY: clock borrows the unused panel TE pin IO38.
             * SPI (not bit-bang): this Zephyr's GPIO ws2812 driver is nRF-only. */
            pinmux = <SPIM3_MOSI_GPIO46>,
                     <SPIM3_SCLK_GPIO38>;
        };
    };
};

&spi3 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    pinctrl-0 = <&spim3_default>;
    pinctrl-names = "default";

    /* IO46 = &gpio1 14 (gpio1 covers IO32-48); a strapping pin (ROM message
     * output) — idling low at reset only changes ROM log behaviour. */
    indicator_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <8>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

&i2s0 {
    /* GDMA 2/3 by default — free (spi2 holds 0/1). */
    status = "okay";
    pinctrl-0 = <&i2s0_default>;
    pinctrl-names = "default";
};

&adc1 {
    status = "okay";
};
