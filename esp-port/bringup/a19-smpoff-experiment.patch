--- a/app/src/ble.c
+++ b/app/src/ble.c
@@ -601,7 +601,9 @@ static void le_param_updated(struct bt_conn *conn, uint16_t interval, uint16_t l
 static struct bt_conn_cb conn_callbacks = {
     .connected = connected,
     .disconnected = disconnected,
+#ifdef CONFIG_BT_SMP
     .security_changed = security_changed,
+#endif
     .le_param_updated = le_param_updated,
 };
 
@@ -689,6 +691,7 @@ static void auth_pairing_complete(struct bt_conn *conn, bool bonded) {
     update_advertising();
 };
 
+#ifdef CONFIG_BT_SMP /* a19 A19: auth API vanishes without SMP */
 static struct bt_conn_auth_cb zmk_ble_auth_cb_display = {
     .pairing_accept = auth_pairing_accept,
 // .passkey_display = auth_passkey_display,
@@ -702,6 +705,7 @@ static struct bt_conn_auth_cb zmk_ble_auth_cb_display = {
 static struct bt_conn_auth_info_cb zmk_ble_auth_info_cb_display = {
     .pairing_complete = auth_pairing_complete,
 };
+#endif /* CONFIG_BT_SMP (auth cbs) */
 
 static void zmk_ble_ready(int err) {
     LOG_DBG("ready? %d", err);
@@ -745,8 +749,10 @@ static int zmk_ble_complete_startup(void) {
 #endif // IS_ENABLED(CONFIG_ZMK_BLE_CLEAR_BONDS_ON_START)
 
     bt_conn_cb_register(&conn_callbacks);
+#ifdef CONFIG_BT_SMP
     bt_conn_auth_cb_register(&zmk_ble_auth_cb_display);
     bt_conn_auth_info_cb_register(&zmk_ble_auth_info_cb_display);
+#endif
 
     zmk_ble_ready(0);
 
