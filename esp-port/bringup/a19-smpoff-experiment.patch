diff --git a/app/Kconfig b/app/Kconfig
index 1ba8e621..a49d9cf2 100644
--- a/app/Kconfig
+++ b/app/Kconfig
@@ -176,9 +176,8 @@ config ZMK_USB_DEVICE
 menuconfig ZMK_BLE
     bool "BLE (HID over GATT)"
     select BT
-    select BT_SMP
-    select BT_SMP_SC_PAIR_ONLY
-    select BT_SMP_APP_PAIRING_ACCEPT
+    # a13 A19 bench experiment: SMP selects lifted so BT_SMP=n can be
+    # set (open-link wedge discrimination). REVERT after the experiment.
     select BT_PERIPHERAL
     select BT_DIS
     imply BT_DEVICE_NAME_DYNAMIC
@@ -385,6 +384,15 @@ config ZMK_VKEY_SHELL
       are real keymap positions (zmk-config cobantab1a.keymap) — there
       is no separate vkeymap model anymore (a13 audit).
 
+config ZMK_VKEY_BENCH
+    bool "Firmware-resident position-edge hammer (a13 forensics)"
+    help
+      Brings up BLE like normal, then self-fires press/release on one
+      keymap position forever from the system workqueue — with SHELL
+      and LOG compiled OUT, so the notification path is exercised with
+      ZERO console traffic. Isolation probe for the a13 wedge (console
+      vs pure BLE TX). Bench only; never product.
+
 menuconfig ZMK_RGB_UNDERGLOW
     bool "RGB Addressable LED Underglow"
     select LED_STRIP
