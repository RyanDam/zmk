choice LV_TXT_ENC
    default LV_TXT_ENC_UTF8

endchoice

config LV_Z_MEM_POOL_SIZE
    default 4096 if ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN

choice ZMK_DISPLAY_STATUS_SCREEN
    prompt "Default status screen for displays"

config ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
    bool "Built in status screen"
    select LV_OBJ_LABEL
    imply LV_USE_THEME_MONO if LV_Z_BITS_PER_PIXEL=1
    imply ZMK_WIDGET_LAYER_STATUS
    imply ZMK_WIDGET_BATTERY_STATUS
    imply ZMK_WIDGET_OUTPUT_STATUS
    imply ZMK_WIDGET_PERIPHERAL_STATUS

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    bool "Custom status screen"

endchoice

config ZMK_DISPLAY_CLOCK_SCREEN
    bool "Clock and calendar status screen"
    depends on ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    default y
    select LV_USE_LABEL
    select LV_USE_FLEX if ZMK_DISPLAY_DESIGN_SYSTEM
    select ENTROPY_GENERATOR if !ZMK_DISPLAY_DESIGN_SYSTEM
    select LV_FONT_MONTSERRAT_48 if !ZMK_DISPLAY_DESIGN_SYSTEM
    select LV_FONT_MONTSERRAT_20 if !ZMK_DISPLAY_DESIGN_SYSTEM
    select LV_FONT_MONTSERRAT_12 if !ZMK_DISPLAY_DESIGN_SYSTEM
    help
      Status screen showing a clock and the calendar, refreshed once per
      second, fed by the display time-source seam (a09): a simulated
      epoch plus system uptime until an RTC (h02) or the host (a14)
      takes over — the screen shows the time unconditionally (the a09
      "unsynced" mark was removed in the wave-1 audit).
      With the design system the page composes the clock and calendar
      widget modules in one of three layouts (clock only, calendar only,
      fusion) with a per-widget style; the live layout/style config
      persists via settings ("display/clock/config") and the seam in
      <zmk/display/clock_screen.h> is the host (a14 RPC) entry point.
      On boards without the design system it falls back to the original
      hardcoded styling (tap = random color demo).

if ZMK_DISPLAY_CLOCK_SCREEN

config ZMK_DISPLAY_CLOCK_EPOCH_S
    int "Simulated clock reference epoch (seconds since 1970-01-01 UTC)"
    default 1794657600
    help
      Wall-clock start of the simulated time source (default
      2026-11-14 12:00:00 UTC, the historical CLOCK_BASE_EPOCH_S). The
      clock screen shows this + uptime, flagged unsynced, until h02's
      RTC driver or a14's host sync takes over.

if ZMK_DISPLAY_DESIGN_SYSTEM

# Boot defaults for the layout + widget style knobs; the live values live
# in settings ("display/clock/config"), are tap-cycled on the glass (bench
# seam) and set from the host through zmk_display_clock_config_set()
# (a14). Enum values match <zmk/display/clock_screen.h> and the widget
# headers, so the RPC ids cannot drift (BUILD_ASSERTs in clock_screen.c).

config ZMK_DISPLAY_CLOCK_LAYOUT
    int "Default clock screen layout (0 clock only, 1 calendar only, 2 fusion)"
    range 0 2
    default 0

config ZMK_DISPLAY_CLOCK_STYLE
    int "Default clock widget style (0 sans; serif/tabular cut in wave 1)"
    range 0 0
    default 0

config ZMK_DISPLAY_CLOCK_CALENDAR_STYLE
    int "Default calendar widget style (0 month grid)"
    range 0 0
    default 0

endif # ZMK_DISPLAY_DESIGN_SYSTEM

endif # ZMK_DISPLAY_CLOCK_SCREEN

menuconfig ZMK_DISPLAY_DESIGN_SYSTEM
    bool "Display design system (theme model, style registry, tab1a fonts)"
    depends on ZMK_DISPLAY
    default y if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    help
      The shared visual foundation for display-centric boards (workspace
      backlog a07): a 5-slot theme model persisted via settings, a single
      style registry that screens must use for colors/fonts/sizes, and the
      generated 320x480 typography ramp. See src/display/grid.md.

if ZMK_DISPLAY_DESIGN_SYSTEM

if !ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN

config ZMK_DISPLAY_THEME_BACKGROUND
    hex "Theme background color (RGB888)"
    default 0x14161C

config ZMK_DISPLAY_THEME_TEXT_PRIMARY
    hex "Theme primary text color (RGB888)"
    default 0xE6E6E6

config ZMK_DISPLAY_THEME_TEXT_SECONDARY
    hex "Theme secondary text color (RGB888)"
    default 0x8A8F98

config ZMK_DISPLAY_THEME_ACCENT
    hex "Theme accent color (RGB888)"
    default 0xE8A33D

config ZMK_DISPLAY_THEME_INACTIVE
    hex "Theme inactive/track color (RGB888)"
    default 0x3A3F49

endif # !ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN

endif # ZMK_DISPLAY_DESIGN_SYSTEM

menuconfig ZMK_DISPLAY_SCREEN_MGR
    bool "Screen manager + touch shell (pages, swipe nav, boot splash, idle backlight)"
    depends on ZMK_DISPLAY_DESIGN_SYSTEM
    select LV_USE_LABEL
    select LV_USE_IMAGE
    select LV_USE_RLE
    select LV_BIN_DECODER_RAM_LOAD
    help
      Replaces the single hard-wired status screen with a page system
      (workspace backlog a08): screens self-register, swipe left/right on
      the touch panel changes pages, a boot splash gives way to a
      persisted home page, and the backlight dims on touch idle, then blanks
      unless the blank timeout is 0 — any touch brings it back. Other features
      suppress the idle policy through zmk_display_blank_lock(). Requires the
      design system (a07) for styling.

      The boot splash shows the owner art
      (src/display/images/coban_bootscreen.c, an LVGL I2+RLE blob:
      4 grey levels, ~2 KB flash, 38 KB RAM while shown — hence the
      LV_USE_IMAGE/LV_USE_RLE/LV_BIN_DECODER_RAM_LOAD selects).

if ZMK_DISPLAY_SCREEN_MGR

config ZMK_DISPLAY_SCREEN_MGR_MAX_SCREENS
    int "Maximum number of registered screens"
    default 8

config ZMK_DISPLAY_BOOT_SPLASH_MS
    int "Boot splash duration (ms, 0 disables the splash)"
    default 1500

config ZMK_DISPLAY_DIM_TIMEOUT_MS
    int "Touch-idle time before dimming the backlight (ms)"
    default 60000

config ZMK_DISPLAY_BLANK_TIMEOUT_MS
    int "Touch-idle time before blanking the backlight (ms, 0 never blanks)"
    default 120000
    help
      Time without touch after which the idle policy stops LVGL ticking and
      switches the backlight off. Set it to 0 to keep the panel lit: idle then
      stops at the dim rung (full -> dim, wake on touch) and never goes dark.
      Boards with a battery should weigh that against their current budget
      (workspace backlog p01).

config ZMK_DISPLAY_DIM_LEVEL
    int "Backlight duty while dimmed (percent, 1-99)"
    range 1 99
    default 40

config ZMK_DISPLAY_TOUCH_DEBUG
    bool "On-glass touch readout (bench harness A06)"
    default n
    help
      Development aid only: a translucent "touch dbg" chip on every page (and
      a full "dbg" page with a dot following the finger plus the controller's
      watchdog state) showing raw touch coordinates, the swipe verdict and
      event counters. Always off in product builds — it covers the UI and adds
      a page to the swipe order.

      Backlog d05 (CONFIG_ZMK_DISPLAY_DEBUG_OVERLAY) is the planned successor
      with a runtime toggle and more seams; this knob exists so the A06 harness
      stays reachable for bench sessions without shipping it.

endif # ZMK_DISPLAY_SCREEN_MGR

config ZMK_DISPLAY_DEBUG_LAYOUT
    bool "Layout debug borders on every container (bench harness)"
    default n
    help
      Development aid only: draws a colored outline on every plain LVGL
      container — the tiles, chips, boxes and tracks of every page — so
      page boxes, the reach band and flex padding are visible on the glass
      while debugging layout. Labels, arcs and scrollbars stay clean, the
      border draws inside the object box (nothing moves), and containers
      created after boot (widget rebuilds) are outlined too.

      Always off in product builds — it frames the whole UI. Complements
      the CONFIG_ZMK_DISPLAY_TOUCH_DEBUG harness (A06); backlog d05 may
      fold it under one debug-overlay toggle later.

if ZMK_DISPLAY_DEBUG_LAYOUT

config ZMK_DISPLAY_DEBUG_LAYOUT_PX
    int "Debug border width (px)"
    range 1 8
    default 1

config ZMK_DISPLAY_DEBUG_LAYOUT_COLOR
    hex "Debug border color (RGB888)"
    default 0xFF0000

endif # ZMK_DISPLAY_DEBUG_LAYOUT

config ZMK_DISPLAY_POMODORO_SCREEN
    bool "Pomodoro screen (breath quote, hold-to-start, session bar)"
    depends on ZMK_DISPLAY_SCREEN_MGR && ZMK_POMODORO
    default y
    select LV_USE_LABEL
    help
      pad10a-spirit page (a10): Vietnamese quote over a breathing white
      disc when idle; tapping the page opens a confirm dialog (Start
      with the config summary / Cancel with the time left, plus a close
      ghost); running shows the countdown (rest flips to the fusion
      split: stacked digits on the disc left, quote right) over a
      segmented whole-session bar (work/rest blocks, width-proportional).
      No on-page config UI: durations live in Kconfig defaults + the
      a14 RPC seam.

menuconfig ZMK_DISPLAY_ANIM
    bool "Asset-backed animations (boot splash + animated clock bg)"
    depends on ZMK_DISPLAY_SCREEN_MGR && ZMK_ASSETS
    default y
    select LV_USE_GIF
    # lv_gif derives from lv_image
    select LV_USE_IMAGE
    help
      Plays GIF/Lottie assets from the flash asset store (a12): a boot
      animation ("boot" asset over the splash) and an animated
      background behind the clock ("animbg", toggle persisted at
      display/anim/bg). Frame buffer canvases need the PSRAM LVGL heap
      sized in the board conf.

if ZMK_DISPLAY_ANIM

config ZMK_DISPLAY_ANIM_BUILTIN
    bool "Ship a built-in default animation in the firmware image"
    default y
    help
      Embeds app/src/display/assets/animbg.gif in the app image and
      registers it as the built-in "animbg" asset, so a device with a
      blank assets partition still animates (ESP32 flash is mapped;
      the store streams from the image through the normal read seam).
      Partition assets override built-ins by name, so host uploads
      (a15) keep the last word. ~2 MB of image size. The stock blob
      is bench fan-art — replace it with licensed art before product
      units ship (a12 decision note). Replacement GIFs must be full
      opaque frames (no transparency, no interlacing) — see the
      encode rules in backlogs/a12.

config ZMK_DISPLAY_ANIM_SCREEN
    bool "Standalone animation page"
    default y
    select LV_USE_GIF
    help
      Extra swipeable page (after the keymap page) that plays the
      animation assets full-bleed: "animbg" first, tap cycles the
      other GIFs in the store. Plays independently of the animated-
      background setting, which only scopes other screens.

config ZMK_DISPLAY_ANIM_LOTTIE
    bool "Lottie playback (ThorVG vector renderer)"
    select LV_USE_VECTOR_GRAPHIC
    select LV_USE_CANVAS
    select LV_USE_LOTTIE
    help
      Renders .json Lottie assets through LVGL's bundled ThorVG. The
      ThorVG flavor is a Kconfig choice, so the board conf must also
      set CONFIG_LV_USE_THORVG=y and CONFIG_LV_USE_THORVG_INTERNAL=y.
      Bigger code footprint; GIF-only builds work without it.

endif # ZMK_DISPLAY_ANIM

config ZMK_DISPLAY_KEYMAP_SCREEN
    bool "Key matrix screen (3x4 virtual keys, pad10a layer-screen style)"
    depends on ZMK_DISPLAY_SCREEN_MGR
    default y
    select LV_USE_LABEL
    help
      Page rendering the virtual half of the real keymap (positions
      4..15 of the 4x4/16-position matrix; row 0 = the four h04 hardware
      keys, off-screen) as the pad10a layer-screen frame: all drawn cells
      are plain keys (grid on top), and the layer indicator pips at the
      bottom double as buttons (tap pip n -> layer n), with touch tiles
      whose press/
      release edges fire through the same position-state path as
      hardware keys. Tiles follow the active keymap layer; bindings
      and macro names redraw live via the keymap/macro change events.

config ZMK_DISPLAY_STATS_SCREEN
    bool "Hardware stats screen (feed seam + layouts)"
    depends on ZMK_DISPLAY_SCREEN_MGR && ZMK_STATS
    default y
    select LV_USE_LABEL
    help
      Page rendering four zmk/stats slots in 2x1 / 2x2 / hybrid / 2x4
      layouts; tapping a cell cycles that slot's metric, tapping the
      background cycles layouts (persisted in settings
      "display/stats/config").

