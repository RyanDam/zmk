# Tab 1a bring-up modules (workspace backlog h01/c02)

config ZMK_TAB1A_HARNESS
	bool "Tab 1a dev harness probes"
	default n
	help
	  Bench bring-up probes for the tab1a dev harness overlay
	  (zmk/esp-port/bringup/tab1a-devkit.overlay): WS2812 chase, key
	  event logging, I2S test tone and a VBAT ADC read. Each probe is
	  additionally gated on the corresponding devicetree node, so
	  enabling this without the overlay is harmless. Not for product
	  builds.

config ZMK_TAB1A_DEBUG
	bool "Tab 1a boot-time storage/flash debug dump"
	default n
	select SETTINGS
	help
	  For the c02 qualification work: forces CONFIG_SETTINGS on even
	  with BLE disabled (it is normally only implied by ZMK_BLE), then
	  at boot dumps the storage flash area and runs a settings
	  write/read round-trip, so the `flash_esp32` error-261 failure is
	  reproducible independent of Bluetooth. Logs everything; not for
	  product builds.
