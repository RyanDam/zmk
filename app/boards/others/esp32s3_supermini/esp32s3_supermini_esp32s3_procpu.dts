/dts-v1/;

#include <espressif/esp32s3/esp32s3.dtsi>
#include "esp32s3_supermini_esp32s3_procpu-pinctrl.dtsi"
#include <espressif/partitions_0x0_default_4M.dtsi>

/*
 * ESP32-S3 SuperMini (PROCPU only).
 *
 * Qualified against the common contemporary sample marked
 * ESP32-S3FH4R2: 4 MB embedded flash + 2 MB quad-SPI PSRAM, USB-C wired to
 * the internal PHY in USB-Serial/JTAG mode (no external PHY). No
 * compatibility is claimed for other SuperMini clones until their chip
 * marking and wiring are tested.
 *
 * - Console/flash/recovery: USB Serial/JTAG (fixed-function GPIO19/20).
 * - Recovery console: UART0 on GPIO43/44, kept out of the matrix fixture.
 * - PSRAM: the wroom_n4r2 include describes the 2 MB QSPI PSRAM node; it is
 *   left unused (no CONFIG_ESP_SPIRAM) until dedicated memory/boot
 *   validation on the exact FH4R2 board.
 */

/*
 * Flash and PSRAM geometry for the ESP32-S3 SuperMini (N4R2: 4 MB flash, 2 MB
 * QSPI PSRAM). Zephyr 4.5 removed the per-module dtsi files under
 * dts/xtensa/espressif/<soc>/ (esp32s3_wroom_n4r2.dtsi among them), so each
 * board now states its own geometry; this is what that include used to do.
 * The PSRAM size is declared but not used - no CONFIG_ESP_SPIRAM here.
 */
&flash0 {
    reg = <0x0 DT_SIZE_M(4)>;
};

&psram0 {
    size = <DT_SIZE_M(2)>;
};

/ {
    model = "ESP32-S3 SuperMini PROCPU";
    compatible = "espressif,esp32s3_supermini";

    chosen {
        zephyr,sram = &sram1;
        zephyr,console = &usb_serial;
        zephyr,shell-uart = &usb_serial;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_partition;
        zephyr,bt-hci = &esp32_bt_hci;
    };

    aliases {
        watchdog0 = &wdt0;
        uart-0 = &uart0;
    };
};

&usb_serial {
    status = "okay";
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-names = "default";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&trng0 {
    status = "okay";
};

&wdt0 {
    status = "okay";
};

&esp32_bt_hci {
    status = "okay";
};

&wifi {
    status = "okay";
};
