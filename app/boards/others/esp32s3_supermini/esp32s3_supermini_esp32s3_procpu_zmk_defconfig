# enable GPIO
CONFIG_GPIO=y

# BLE HID only: ZMK USB stays disabled on the S3 SuperMini (USB HID is a
# separate, gated configuration pending the S3 USB-PHY/eFuse decision)
CONFIG_ZMK_BLE=y

# Console over the built-in USB Serial/JTAG port (GPIO19/20); UART0
# (GPIO43/44) stays available as the recovery console
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y

# Settings support (NVS on the storage partition of the 4 MB flash layout)
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
