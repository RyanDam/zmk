# enable GPIO
CONFIG_GPIO=y

# BLE HID only: the ESP32-C3 has no USB OTG, so ZMK USB is not available
CONFIG_ZMK_BLE=y

# Console over the built-in USB Serial/JTAG port (UART0 is unavailable:
# GPIO20/21 are matrix fixture pins)
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y

# Settings support (NVS on the storage partition of the 4 MB flash layout)
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
