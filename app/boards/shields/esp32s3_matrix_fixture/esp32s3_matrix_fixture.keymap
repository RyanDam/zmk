#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT  0
#define BT_LAYER 1

/ {
    keymap: keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4
                &kp NUMBER_5 &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8
                &kp NUMBER_9 &kp NUMBER_0 &kp MINUS    &kp EQUAL
                &kp A        &kp B        &kp C        &lt BT_LAYER D
            >;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
                &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &bt BT_SEL 0
            >;
        };
    };
};
