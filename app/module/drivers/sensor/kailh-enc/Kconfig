menuconfig KAILH_ENC
    bool "Kailh ENC Incremental Encoder Sensor"
    default y
    depends on DT_HAS_KAILH_ENC_ENABLED
    depends on GPIO
    help
      Enable driver for Kailh ENC incremental encoder sensors.

if KAILH_ENC

choice KAILH_ENC_TRIGGER_MODE
    prompt "Trigger mode"
    default KAILH_ENC_TRIGGER_NONE
    help
      Specify the type of triggering to be used by the driver.

config KAILH_ENC_TRIGGER_NONE
    bool "No trigger"

config KAILH_ENC_TRIGGER_GLOBAL_THREAD
    bool "Use global thread"
    depends on GPIO
    select KAILH_ENC_TRIGGER

config KAILH_ENC_TRIGGER_OWN_THREAD
    bool "Use own thread"
    depends on GPIO
    select KAILH_ENC_TRIGGER

endchoice

config KAILH_ENC_TRIGGER
    bool

config KAILH_ENC_THREAD_PRIORITY
    int "Thread priority"
    depends on KAILH_ENC_TRIGGER_OWN_THREAD
    default 10
    help
      Priority of thread used by the driver to handle interrupts.

config KAILH_ENC_THREAD_STACK_SIZE
    int "Thread stack size"
    depends on KAILH_ENC_TRIGGER_OWN_THREAD
    default 1024
    help
      Stack size of thread used by the driver to handle interrupts.

endif # KAILH_ENC
