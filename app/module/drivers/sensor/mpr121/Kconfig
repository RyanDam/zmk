menuconfig MPR121
    bool "NXP MPR121 Capacitive Touchpad"
    default n
    depends on I2C
    depends on GPIO
    depends on INPUT
    help
      Enable driver for NXP MPR121 capacitive touchpad sensor.
      Provides touch coordinate tracking and swipe gesture detection.

if MPR121

choice MPR121_TRIGGER_MODE
    prompt "Trigger mode"
    default MPR121_TRIGGER_GLOBAL_THREAD

config MPR121_TRIGGER_NONE
    bool "No trigger (polling)"

config MPR121_TRIGGER_GLOBAL_THREAD
    bool "Use global thread"
    depends on GPIO
    select MPR121_TRIGGER

config MPR121_TRIGGER_OWN_THREAD
    bool "Use own thread"
    depends on GPIO
    select MPR121_TRIGGER

endchoice

config MPR121_TRIGGER
    bool

endif # MPR121
